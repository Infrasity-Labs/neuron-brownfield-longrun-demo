+export const COMMENT_EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+// Provisional: the rule source gives no status code for a refused edit.
+// Confirm the code before release. 403 matches the other not-author refusals.
+export const REFUSED_COMMENT_EDIT_STATUS = 403;
+
+export const updateComment = async (body: string, slug: string, commentId: number, id: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id: commentId,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+      author: {
+        select: {
+          id: true,
+        },
+      },
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (comment.author.id !== id) {
+    throw new HttpException(REFUSED_COMMENT_EDIT_STATUS, {
+      errors: { comment: ['only the author may edit this comment'] },
+    });
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new HttpException(REFUSED_COMMENT_EDIT_STATUS, {
+      errors: { comment: ['can no longer be edited'] },
+    });
+  }
+
+  const updatedComment = await prisma.comment.update({
+    where: {
+      id: commentId,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
   });
+
+  return {
+    id: updatedComment.id,
+    createdAt: updatedComment.createdAt,
+    updatedAt: updatedComment.updatedAt,
+    editedAt: updatedComment.editedAt,
+    body: updatedComment.body,
+    author: {
+      username: updatedComment.author.username,
+      bio: updatedComment.author.bio,
+      image: updatedComment.author.image,
+      following: updatedComment.author.followedBy.some((follow: any) => follow.id === id),
+    },
+  };
 };
 
