+import prismaMock from '../prisma-mock';
+import { getArticles } from '../../app/routes/article/article.service';
+
+// Team rule (Okto Neuron, vault "team", policy-article-list-limit.md):
+// maximum 50 articles per request, default 10, a limit above 50 is treated as 50.
+describe('getArticles limit', () => {
+  beforeEach(() => {
+    // @ts-ignore
+    prismaMock.article.count.mockResolvedValue(0);
+    // @ts-ignore
+    prismaMock.article.findMany.mockResolvedValue([]);
+  });
+
+  test('should use the default limit of 10 when no limit is given', async () => {
+    // When
+    await getArticles({});
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenLastCalledWith(
+      expect.objectContaining({ take: 10 }),
+    );
+  });
+
+  test('should use the default limit of 10 when the limit is not a number', async () => {
+    // When
+    await getArticles({ limit: 'abc' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenLastCalledWith(
+      expect.objectContaining({ take: 10 }),
+    );
+  });
+
+  test('should pass a limit below the maximum through unchanged', async () => {
+    // When
+    await getArticles({ limit: '20' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenLastCalledWith(
+      expect.objectContaining({ take: 20 }),
+    );
+  });
+
+  test('should allow a limit equal to the maximum of 50', async () => {
+    // When
+    await getArticles({ limit: '50' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenLastCalledWith(
+      expect.objectContaining({ take: 50 }),
+    );
+  });
+
+  test('should treat a limit above 50 as 50', async () => {
+    // When
+    await getArticles({ limit: '100' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenLastCalledWith(
+      expect.objectContaining({ take: 50 }),
+    );
+  });
+});
