+    test('should treat a limit above the maximum as 50', async () => {
+      // Given
+      const query = { limit: '1000' };
+
+      // When
+      await getArticles(query);
+
+      // Then
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 50 }));
+    });
