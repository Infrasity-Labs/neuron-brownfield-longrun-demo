+import prismaMock from '../prisma-mock';
+import { deleteComment, getCommentsByArticle } from '../../app/routes/article/article.service';
+
+const slug = 'How-to-train-your-dragon-456';
+const commentId = 123;
+const userId = 456;
+
+const mockedCommentLookup = () => ({
+  author: {
+    id: userId,
+    username: 'RealWorld',
+  },
+});
+
+describe('CommentSoftDeleteService', () => {
+  describe('deleteComment', () => {
+    test('should set deletedAt and keep the row when the author deletes their comment', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup());
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await deleteComment(commentId, userId);
+
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId },
+          data: { deletedAt: expect.any(Date) },
+        }),
+      );
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should only look up comments owned by the caller that are not already deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup());
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await deleteComment(commentId, userId);
+
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: {
+            id: commentId,
+            deletedAt: null,
+            author: { id: userId },
+          },
+        }),
+      );
+    });
+
+    test('should throw a 404 and not update the row when the comment is not found or not owned by the caller', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, userId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    test('should leave out comments that have a deletedAt value', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // Then
+      await getCommentsByArticle(slug, userId);
+
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: expect.objectContaining({ deletedAt: null }),
+            }),
+          },
+        }),
+      );
+    });
+  });
+});
