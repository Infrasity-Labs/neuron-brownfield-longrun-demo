--- /dev/null
+++ b/app/src/tests/services/article.comment-soft-delete.service.test.ts
@@ -0,0 +1,192 @@
+import prismaMock from '../prisma-mock';
+import {
+  deleteComment,
+  getCommentsByArticle,
+  updateComment,
+} from '../../app/routes/article/article.service';
+
+describe('ArticleService comment soft delete', () => {
+  const slug = 'How-to-train-your-dragon';
+  const commentId = 123;
+  const authorId = 456;
+
+  describe('deleteComment', () => {
+    test('should set deletedAt instead of removing the comment', async () => {
+      // Given
+      const before = new Date();
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await deleteComment(commentId, authorId);
+
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: {
+            id: commentId,
+            deletedAt: null,
+            author: { id: authorId },
+          },
+        }),
+      );
+      expect(prismaMock.comment.update).toHaveBeenCalledWith({
+        where: { id: commentId },
+        data: { deletedAt: expect.any(Date) },
+      });
+      const { data } = (prismaMock.comment.update as unknown as jest.Mock).mock.calls[0][0];
+      expect(data.deletedAt.getTime()).toBeGreaterThanOrEqual(before.getTime());
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should treat an already deleted comment as not found', async () => {
+      // Given
+      const userId = authorId;
+
+      // When
+      // The deletedAt filter in the query means a deleted comment is not returned
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, userId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should refuse the delete when the user is not the author', async () => {
+      // Given
+      const otherUserId = 999;
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, otherUserId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ author: { id: otherUserId } }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('updateComment', () => {
+    test('should refuse to edit a deleted comment as not found', async () => {
+      // Given
+      const body = 'Edited body';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ deletedAt: null }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    const mockedComment = {
+      id: commentId,
+      createdAt: new Date('2026-10-01T10:00:00Z'),
+      updatedAt: new Date('2026-10-01T10:00:00Z'),
+      body: 'Still here',
+      author: {
+        username: 'RealWorld',
+        bio: null,
+        image: null,
+        followedBy: [{ id: 789 }],
+      },
+    };
+
+    test('should leave deleted comments out of the query', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // When
+      await getCommentsByArticle(slug);
+
+      // Then
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: {
+                OR: [{ author: { demo: true } }],
+                deletedAt: null,
+              },
+            }),
+          },
+        }),
+      );
+    });
+
+    test('should keep the viewer own comments in the filter alongside deletedAt', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // When
+      await getCommentsByArticle(slug, authorId);
+
+      // Then
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: {
+                OR: [{ author: { demo: true } }, { author: { id: authorId } }],
+                deletedAt: null,
+              },
+            }),
+          },
+        }),
+      );
+    });
+
+    test('should return the comments from the query with the following flag', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [mockedComment] });
+
+      // When
+      const result = await getCommentsByArticle(slug, 789);
+
+      // Then
+      expect(result).toEqual([
+        {
+          id: commentId,
+          createdAt: mockedComment.createdAt,
+          updatedAt: mockedComment.updatedAt,
+          body: 'Still here',
+          author: {
+            username: 'RealWorld',
+            bio: null,
+            image: null,
+            following: true,
+          },
+        },
+      ]);
+    });
+  });
+});
