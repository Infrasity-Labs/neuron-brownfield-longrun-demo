# Copy to .env and fill in. .env is git-ignored. Never commit a key.
# Load it before running the scripts:  set -a; source .env; set +a

# Which model Neuron uses for ingest and ask. These feed scripts/setup_vaults.sh, which passes them to
# `okto-neuron onboard`. Pick a provider preset from the Neuron README, for example openrouter, openai, gemini.
# For OpenRouter use DEMO_LLM_PROVIDER=openai and DEMO_LLM_API_BASE=https://openrouter.ai/api/v1 (see docs/VERIFIED.md).
DEMO_LLM_PROVIDER=
DEMO_LLM_MODEL=
# Leave empty to use the preset's own base URL. Set it for a custom endpoint.
DEMO_LLM_API_BASE=
# The NAME of the variable that holds the key. Neuron wants it to start with OKTO_NEURON_.
DEMO_LLM_API_KEY_ENV=OKTO_NEURON_LLM_API_KEY
# The key itself, under the name given above.
OKTO_NEURON_LLM_API_KEY=

# Postgres from docker-compose.yml, used by the target app in app/.
DATABASE_URL=postgresql://realworld:realworld@localhost:5433/realworld

# Optional overrides for run_demo.py. The defaults are the paths Neuron's own docs use.
# OKTO_NEURON_MCP_URL=http://127.0.0.1:8201/mcp
# OKTO_NEURON_TOKEN_FILE=~/.okto-neuron/daemon-7777.token
# OKTO_NEURON_VAULTS_DIR=~/.okto-neuron/vaults
