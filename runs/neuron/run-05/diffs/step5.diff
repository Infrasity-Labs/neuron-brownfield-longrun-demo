+// No rule in the team vault gives the status for a refused edit (see the spec).
+// 403 is a placeholder taken from the ownership checks in updateArticle and deleteComment.
+// Confirm the value before merge.
+export const EDIT_REFUSED_STATUS = 403;
+// Comments can be edited for 30 minutes after creation (team vault: policy-edit-window.md).
+const EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+export const updateComment = async (body: string, slug: string, id: number, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+      author: {
+        select: {
+          id: true,
+        },
+      },
+    },
+  });
+
+  if (!comment || comment.author.id !== userId) {
+    throw new HttpException(EDIT_REFUSED_STATUS, { errors: { comment: ['cannot be edited'] } });
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > EDIT_WINDOW_MS) {
+    throw new HttpException(EDIT_REFUSED_STATUS, {
+      errors: { comment: ['edit window has passed'] },
+    });
+  }
+
+  const updatedComment = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updatedComment.id,
+    createdAt: updatedComment.createdAt,
+    updatedAt: updatedComment.updatedAt,
+    editedAt: updatedComment.editedAt,
+    body: updatedComment.body,
+    author: {
+      username: updatedComment.author.username,
+      bio: updatedComment.author.bio,
+      image: updatedComment.author.image,
+      following: updatedComment.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
