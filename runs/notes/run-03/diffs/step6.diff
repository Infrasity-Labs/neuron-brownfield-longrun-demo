+const COMMENT_EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+// No rule note sets the status for a refused edit. 500 is the catch-all status in
+// code-error-shape.md. Change it once the team decides.
+const COMMENT_EDIT_REFUSED_STATUS = 500;
+
+export const editComment = async (body: string, slug: string, id: number, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id,
+      authorId: userId,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(COMMENT_EDIT_REFUSED_STATUS, { errors: { comment: ['not found'] } });
+  }
+
+  const now = new Date();
+
+  if (now.getTime() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new HttpException(COMMENT_EDIT_REFUSED_STATUS, {
+      errors: { comment: ['can no longer be edited'] },
+    });
+  }
+
+  const updated = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      editedAt: now,
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updated.id,
+    createdAt: updated.createdAt,
+    updatedAt: updated.updatedAt,
+    body: updated.body,
+    editedAt: updated.editedAt,
+    author: {
+      username: updated.author.username,
+      bio: updated.author.bio,
+      image: updated.author.image,
+      following: updated.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
