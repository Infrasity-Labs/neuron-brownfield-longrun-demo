+export const updateComment = async (body: string, slug: string, id: number, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id,
+      article: {
+        slug,
+      },
+      author: {
+        id: userId,
+      },
+    },
+    select: {
+      createdAt: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new HttpException(403, {
+      errors: { comment: ["can't be edited after 30 minutes"] },
+    });
+  }
+
+  const updated = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updated.id,
+    createdAt: updated.createdAt,
+    updatedAt: updated.updatedAt,
+    editedAt: updated.editedAt,
+    body: updated.body,
+    author: {
+      username: updated.author.username,
+      bio: updated.author.bio,
+      image: updated.author.image,
+      following: updated.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
