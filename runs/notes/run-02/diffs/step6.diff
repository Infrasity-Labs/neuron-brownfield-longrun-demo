+const COMMENT_EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+export const updateComment = async (
+  body: string,
+  slug: string,
+  commentId: number,
+  userId: number,
+) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id: commentId,
+      article: {
+        slug,
+      },
+      author: {
+        id: userId,
+      },
+    },
+    select: {
+      id: true,
+      createdAt: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new HttpException(403, { errors: { comment: ['edit window has closed'] } });
+  }
+
+  const updatedComment = await prisma.comment.update({
+    where: {
+      id: commentId,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updatedComment.id,
+    createdAt: updatedComment.createdAt,
+    updatedAt: updatedComment.updatedAt,
+    editedAt: updatedComment.editedAt,
+    body: updatedComment.body,
+    author: {
+      username: updatedComment.author.username,
+      bio: updatedComment.author.bio,
+      image: updatedComment.author.image,
+      following: updatedComment.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
