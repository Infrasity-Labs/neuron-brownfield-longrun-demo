+import prismaMock from '../prisma-mock';
+import { deleteComment, getCommentsByArticle } from '../../app/routes/article/article.service';
+
+describe('ArticleService soft delete for comments', () => {
+  const slug = 'How-to-train-your-dragon';
+  const commentId = 123;
+  const authorId = 456;
+  const otherUserId = 789;
+
+  describe('deleteComment', () => {
+    const mockedCommentLookup = {
+      author: {
+        id: authorId,
+        username: 'RealWorld',
+      },
+    };
+
+    test('should keep the row and set deletedAt for the author', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup);
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).resolves.toBeUndefined();
+      expect(prismaMock.comment.update).toHaveBeenCalledWith({
+        where: { id: commentId },
+        data: { deletedAt: expect.any(Date) },
+      });
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should only look up comments that are not already deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup);
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await deleteComment(commentId, authorId);
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({
+            id: commentId,
+            deletedAt: null,
+            author: { id: authorId },
+          }),
+        }),
+      );
+    });
+
+    test('should throw 404 when the comment is missing', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw 404 when someone who is not the author tries to delete it', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, otherUserId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ author: { id: otherUserId } }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw 404 when the comment was already deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    test('should leave out deleted comments from the comment list', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // Then
+      await getCommentsByArticle(slug);
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: expect.objectContaining({
+            comments: expect.objectContaining({
+              where: expect.objectContaining({ deletedAt: null }),
+            }),
+          }),
+        }),
+      );
+    });
+  });
+});
