+// Team rule: a comment may be edited for 30 minutes after it was created.
+const COMMENT_EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+export const updateComment = async (
+  body: string,
+  slug: string,
+  commentId: number,
+  userId: number,
+) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id: commentId,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      id: true,
+      createdAt: true,
+      authorId: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  // OPEN GAP: no team rule says which status code to use when a non-author edits,
+  // or when the edit window has passed. Until the team decides, these throw a plain
+  // Error, which the app's error handler returns as 500. This is a placeholder, not a rule.
+  if (comment.authorId !== userId) {
+    throw new Error('Comment edit refused: not the author (no team rule sets the status code)');
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new Error('Comment edit refused: edit window passed (no team rule sets the status code)');
+  }
+
+  const updatedComment = await prisma.comment.update({
+    where: {
+      id: comment.id,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
   });
+
+  return {
+    id: updatedComment.id,
+    createdAt: updatedComment.createdAt,
+    updatedAt: updatedComment.updatedAt,
+    editedAt: updatedComment.editedAt,
+    body: updatedComment.body,
+    author: {
+      username: updatedComment.author.username,
+      bio: updatedComment.author.bio,
+      image: updatedComment.author.image,
+      following: updatedComment.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
 };
 
