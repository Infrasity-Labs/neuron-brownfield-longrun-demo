+import prismaMock from '../prisma-mock';
+import { deleteComment, getCommentsByArticle } from '../../app/routes/article/article.service';
+
+describe('ArticleService', () => {
+  describe('deleteComment', () => {
+    const id = 1;
+    const authorId = 123;
+
+    test('should set deletedAt on the author own comment and keep the row', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({ id });
+
+      await deleteComment(id, authorId);
+
+      // Then
+      expect(prismaMock.comment.update).toHaveBeenCalledWith({
+        where: { id },
+        data: { deletedAt: expect.any(Date) },
+      });
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should only look for comments that are not already deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(id, authorId)).rejects.toMatchObject({ errorCode: 404 });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ id, deletedAt: null }),
+        }),
+      );
+    });
+
+    test('should reject with 404 when the comment is not found and not update', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(id, authorId)).rejects.toMatchObject({ errorCode: 404 });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should reject with 404 when another user owns the comment and not update', async () => {
+      // The lookup filters by the requester's id, so another user's comment is not found.
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+      const otherUserId = 999;
+
+      // Then
+      await expect(deleteComment(id, otherUserId)).rejects.toMatchObject({ errorCode: 404 });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ id, author: { id: otherUserId } }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    const slug = 'How-to-train-your-dragon';
+
+    test('should leave out comments that have deletedAt set', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      await getCommentsByArticle(slug);
+
+      // Then
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: expect.objectContaining({ deletedAt: null }),
+            }),
+          },
+        }),
+      );
+    });
+
+    test('should return only the live comments that the mock returns', async () => {
+      // When
+      const createdAt = new Date();
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({
+        comments: [
+          {
+            id: 2,
+            createdAt,
+            updatedAt: createdAt,
+            body: 'still here',
+            author: { username: 'RealWorld', bio: null, image: null, followedBy: [] },
+          },
+        ],
+      });
+
+      // Then
+      await expect(getCommentsByArticle(slug)).resolves.toEqual([
+        {
+          id: 2,
+          createdAt,
+          updatedAt: createdAt,
+          body: 'still here',
+          author: { username: 'RealWorld', bio: null, image: null, following: false },
+        },
+      ]);
+    });
+  });
+});
