+import prismaMock from '../prisma-mock';
+import {
+  COMMENT_EDIT_WINDOW_MS,
+  REFUSED_COMMENT_EDIT_STATUS,
+  updateComment,
+} from '../../app/routes/article/article.service';
+
+describe('ArticleService', () => {
+  describe('updateComment', () => {
+    const slug = 'How-to-train-your-dragon';
+    const commentId = 123;
+    const authorId = 456;
+    const body = 'An edited comment';
+
+    const mockedCommentLookup = (createdAt: Date) => ({
+      createdAt,
+      author: {
+        id: authorId,
+      },
+    });
+
+    const mockedUpdatedComment = {
+      id: commentId,
+      createdAt: new Date(),
+      updatedAt: new Date(),
+      editedAt: new Date(),
+      body,
+      author: {
+        username: 'RealWorld',
+        bio: null,
+        image: null,
+        followedBy: [],
+      },
+    };
+
+    test('should update the body and set editedAt for the author within the window', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 60 * 1000);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt));
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).resolves.toHaveProperty(
+        'editedAt',
+      );
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId },
+          data: expect.objectContaining({ body, editedAt: expect.any(Date) }),
+        }),
+      );
+    });
+
+    test('should allow an edit just inside the window', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - COMMENT_EDIT_WINDOW_MS + 60 * 1000);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt));
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).resolves.toHaveProperty(
+        'body',
+        body,
+      );
+    });
+
+    test('should throw 422 when the body is blank', async () => {
+      // Then
+      await expect(updateComment('', slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 422,
+        message: { errors: { body: ["can't be blank"] } },
+      });
+      expect(prismaMock.comment.findFirst).not.toHaveBeenCalled();
+    });
+
+    test('should throw 404 when the comment is not found on the article', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should refuse an edit by someone who is not the author', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 60 * 1000);
+      const otherUserId = 789;
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt));
+
+      // Then
+      await expect(updateComment(body, slug, commentId, otherUserId)).rejects.toMatchObject({
+        errorCode: REFUSED_COMMENT_EDIT_STATUS,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should refuse an edit after the window has passed', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - COMMENT_EDIT_WINDOW_MS - 60 * 1000);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt));
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: REFUSED_COMMENT_EDIT_STATUS,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+});
