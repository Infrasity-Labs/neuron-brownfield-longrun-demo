+import prismaMock from '../prisma-mock';
+import {
+  COMMENT_EDIT_EXPIRED_STATUS,
+  COMMENT_EDIT_NOT_AUTHOR_STATUS,
+  COMMENT_EDIT_WINDOW_MS,
+  updateComment,
+} from '../../app/routes/article/article.service';
+
+describe('ArticleService', () => {
+  describe('updateComment', () => {
+    const now = 1790000000000;
+    const slug = 'How-to-train-your-dragon';
+    const commentId = 123;
+    const authorId = 456;
+
+    const mockedUpdatedComment = (body: string) => ({
+      id: commentId,
+      createdAt: new Date(now - 60 * 1000),
+      updatedAt: new Date(now),
+      editedAt: new Date(now),
+      body,
+      articleId: 1,
+      authorId,
+      author: {
+        username: 'RealWorld',
+        bio: null,
+        image: null,
+        followedBy: [],
+      },
+    });
+
+    let dateNowSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+      dateNowSpy = jest.spyOn(Date, 'now').mockReturnValue(now);
+    });
+
+    afterEach(() => {
+      dateNowSpy.mockRestore();
+    });
+
+    test('should reject an empty body with 422 and not touch the database', async () => {
+      // Given
+      const body = '';
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 422,
+        message: { errors: { body: ["can't be blank"] } },
+      });
+      expect(prismaMock.comment.findFirst).not.toHaveBeenCalled();
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should look the comment up by id and by the article slug', async () => {
+      // Given
+      const body = 'new text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: {
+            id: commentId,
+            article: { slug },
+          },
+        }),
+      );
+    });
+
+    test('should reject with 404 when the comment does not exist', async () => {
+      // Given
+      const body = 'new text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+        message: { errors: { comment: ['not found'] } },
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should refuse an edit by someone other than the author', async () => {
+      // Given
+      const body = 'new text';
+      const otherUserId = 789;
+
+      // When
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(now - 60 * 1000),
+        authorId,
+      } as any);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, otherUserId)).rejects.toMatchObject({
+        errorCode: COMMENT_EDIT_NOT_AUTHOR_STATUS,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should refuse an edit once the 15 minute window has passed', async () => {
+      // Given
+      const body = 'new text';
+
+      // When
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(now - COMMENT_EDIT_WINDOW_MS - 1),
+        authorId,
+      } as any);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: COMMENT_EDIT_EXPIRED_STATUS,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should allow an edit at exactly 15 minutes after creation', async () => {
+      // Given
+      const body = 'new text';
+
+      // When
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(now - COMMENT_EDIT_WINDOW_MS),
+        authorId,
+      } as any);
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(body) as any);
+
+      // Then
+      await expect(updateComment(body, slug, commentId, authorId)).resolves.toHaveProperty(
+        'body',
+        body,
+      );
+    });
+
+    test('should update the body and set editedAt for the author within the window', async () => {
+      // Given
+      const body = 'new text';
+
+      // When
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(now - 60 * 1000),
+        authorId,
+      } as any);
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(body) as any);
+
+      // Then
+      const result = await updateComment(body, slug, commentId, authorId);
+
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId },
+          data: expect.objectContaining({
+            body,
+            editedAt: expect.any(Date),
+          }),
+        }),
+      );
+      expect(result).toEqual(
+        expect.objectContaining({
+          id: commentId,
+          body,
+          editedAt: expect.any(Date),
+        }),
+      );
+    });
+  });
+});
