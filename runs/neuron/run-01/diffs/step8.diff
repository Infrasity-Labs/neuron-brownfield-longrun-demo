+import prismaMock from '../prisma-mock';
+import {
+  ARTICLE_LIST_DEFAULT_LIMIT,
+  ARTICLE_LIST_MAX_LIMIT,
+  getArticles,
+} from '../../app/routes/article/article.service';
+
+describe('ArticleService limit handling in getArticles', () => {
+  beforeEach(() => {
+    // @ts-ignore
+    prismaMock.article.count.mockResolvedValue(0);
+    // @ts-ignore
+    prismaMock.article.findMany.mockResolvedValue([]);
+  });
+
+  test('should use the rule values 10 for the default and 50 for the maximum', () => {
+    expect(ARTICLE_LIST_DEFAULT_LIMIT).toBe(10);
+    expect(ARTICLE_LIST_MAX_LIMIT).toBe(50);
+  });
+
+  test('should take the default limit of 10 when no limit is given', async () => {
+    // When
+    await getArticles({});
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 10 }));
+  });
+
+  test('should take the requested limit when it is within the maximum', async () => {
+    // When
+    await getArticles({ limit: '20' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 20 }));
+  });
+
+  test('should take exactly 50 when the requested limit is 50', async () => {
+    // When
+    await getArticles({ limit: '50' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 50 }));
+  });
+
+  test('should cap a limit above the maximum at 50 instead of rejecting it', async () => {
+    // When
+    await expect(getArticles({ limit: '500' })).resolves.toHaveProperty('articles');
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 50 }));
+  });
+
+  test('should cap a numeric limit above the maximum at 50', async () => {
+    // When
+    await getArticles({ limit: 51 });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 50 }));
+  });
+
+  test('should keep the offset handling unchanged alongside the capped limit', async () => {
+    // When
+    await getArticles({ limit: '1000', offset: '5' });
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+      expect.objectContaining({ take: 50, skip: 5 }),
+    );
+  });
+});
