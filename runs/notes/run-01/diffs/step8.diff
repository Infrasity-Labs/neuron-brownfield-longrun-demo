+++ b/app/src/tests/services/comment-edit.service.test.ts
@@ -0,0 +1,144 @@
+import prismaMock from '../prisma-mock';
+import { editComment } from '../../app/routes/article/article.service';
+
+const MINUTE_MS = 60 * 1000;
+
+const slug = 'How-to-train-your-dragon-456';
+const commentId = 123;
+const userId = 456;
+
+const mockedCommentLookup = (createdAt: Date) => ({
+  createdAt,
+});
+
+const mockedUpdatedComment = (body: string, editedAt: Date) => ({
+  id: commentId,
+  createdAt: new Date(Date.now() - 5 * MINUTE_MS),
+  updatedAt: new Date(Date.now() - 5 * MINUTE_MS),
+  editedAt,
+  body,
+  articleId: 789,
+  authorId: userId,
+  author: {
+    username: 'RealWorld',
+    bio: null,
+    image: null,
+    followedBy: [],
+  },
+});
+
+describe('CommentEditService', () => {
+  describe('editComment', () => {
+    test('should update the body and set editedAt when the author edits within 30 minutes', async () => {
+      // Given
+      const newBody = 'Edited text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(
+        mockedCommentLookup(new Date(Date.now() - 5 * MINUTE_MS)),
+      );
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(newBody, new Date()));
+
+      // Then
+      const result = await editComment(slug, commentId, newBody, userId);
+
+      expect(result.body).toBe(newBody);
+      expect(result.editedAt).toBeInstanceOf(Date);
+      expect(result.author.username).toBe('RealWorld');
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId },
+          data: expect.objectContaining({ body: newBody, editedAt: expect.any(Date) }),
+        }),
+      );
+    });
+
+    test('should only look up comments owned by the caller on that article', async () => {
+      // Given
+      const newBody = 'Edited text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(
+        mockedCommentLookup(new Date(Date.now() - 5 * MINUTE_MS)),
+      );
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(newBody, new Date()));
+
+      // Then
+      await editComment(slug, commentId, newBody, userId);
+
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: {
+            id: commentId,
+            authorId: userId,
+            article: { slug },
+          },
+        }),
+      );
+    });
+
+    test('should allow the edit just inside the 30 minute window', async () => {
+      // Given
+      const newBody = 'Edited text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(
+        mockedCommentLookup(new Date(Date.now() - 29 * MINUTE_MS)),
+      );
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(newBody, new Date()));
+
+      // Then
+      await expect(editComment(slug, commentId, newBody, userId)).resolves.toHaveProperty(
+        'body',
+        newBody,
+      );
+    });
+
+    test('should refuse the edit after 30 minutes and not update the row', async () => {
+      // Given
+      const newBody = 'Edited text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(
+        mockedCommentLookup(new Date(Date.now() - 31 * MINUTE_MS)),
+      );
+
+      // Then
+      await expect(editComment(slug, commentId, newBody, userId)).rejects.toThrowError();
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw a 404 with the errors body when the comment is not found or not owned by the caller', async () => {
+      // Given
+      const newBody = 'Edited text';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(editComment(slug, commentId, newBody, userId)).rejects.toMatchObject({
+        errorCode: 404,
+        message: { errors: { comment: ['not found'] } },
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw a 422 with the errors body when the body is blank', async () => {
+      // Then
+      await expect(editComment(slug, commentId, '', userId)).rejects.toMatchObject({
+        errorCode: 422,
+        message: { errors: { body: ["can't be blank"] } },
+      });
+      expect(prismaMock.comment.findFirst).not.toHaveBeenCalled();
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+});
