+
+export const updateComment = async (body: string, slug: string, id: number, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const existingComment = await prisma.comment.findFirst({
+    where: {
+      id,
+      deletedAt: null,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      author: {
+        select: {
+          id: true,
+        },
+      },
+    },
   });
+
+  if (!existingComment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (existingComment.author.id !== userId) {
+    throw new HttpException(403, {
+      message: 'You are not authorized to update this comment',
+    });
+  }
+
+  const comment = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      updatedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: comment.id,
+    createdAt: comment.createdAt,
+    updatedAt: comment.updatedAt,
+    body: comment.body,
+    author: {
+      username: comment.author.username,
+      bio: comment.author.bio,
+      image: comment.author.image,
+      following: comment.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
 };
 
