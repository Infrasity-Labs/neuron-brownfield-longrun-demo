+import prismaMock from '../prisma-mock';
+import { getArticles } from '../../app/routes/article/article.service';
+
+describe('ArticleService getArticles limit', () => {
+  beforeEach(() => {
+    // @ts-ignore
+    prismaMock.article.count.mockResolvedValue(0);
+    // @ts-ignore
+    prismaMock.article.findMany.mockResolvedValue([]);
+  });
+
+  test('should serve the maximum when the requested limit is above it', async () => {
+    // Given
+    const query = { limit: '1000' };
+
+    // When
+    await getArticles(query);
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 50 }));
+  });
+
+  test('should keep a limit within range unchanged', async () => {
+    // Given
+    const query = { limit: '20' };
+
+    // When
+    await getArticles(query);
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 20 }));
+  });
+
+  test('should serve a limit equal to the maximum unchanged', async () => {
+    // Given
+    const query = { limit: '50' };
+
+    // When
+    await getArticles(query);
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 50 }));
+  });
+
+  test('should use the default limit when limit is missing', async () => {
+    // Given
+    const query = {};
+
+    // When
+    await getArticles(query);
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 10 }));
+  });
+
+  test('should use the default limit when limit is not a number', async () => {
+    // Given
+    const query = { limit: 'abc' };
+
+    // When
+    await getArticles(query);
+
+    // Then
+    expect(prismaMock.article.findMany).toHaveBeenCalledWith(expect.objectContaining({ take: 10 }));
+  });
+});
