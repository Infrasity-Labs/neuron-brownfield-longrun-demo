+import prismaMock from '../prisma-mock';
+import { deleteComment, getCommentsByArticle } from '../../app/routes/article/article.service';
+
+const slug = 'how-to-train-your-dragon-456';
+const commentId = 123;
+const authorId = 456;
+const otherUserId = 999;
+
+describe('ArticleService', () => {
+  describe('deleteComment', () => {
+    test('should set deletedAt and keep the row when the author deletes their comment', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await deleteComment(commentId, authorId);
+
+      expect(prismaMock.comment.update).toHaveBeenCalledWith({
+        where: { id: commentId },
+        data: { deletedAt: expect.any(Date) },
+      });
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should look up only comments that are not already deleted and belong to the user', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // Then
+      await deleteComment(commentId, authorId);
+
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: {
+            id: commentId,
+            deletedAt: null,
+            author: { id: authorId },
+          },
+        }),
+      );
+    });
+
+    test('should throw a 404 with the error object shape and not update when the comment is not found', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+        message: {
+          error: {
+            code: 'comment_not_found',
+            message: 'comment not found',
+          },
+        },
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should throw a 404 and not update when a user other than the author deletes the comment', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, otherUserId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({
+            id: commentId,
+            author: { id: otherUserId },
+          }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw a 404 and not update when the comment was already deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    test('should leave out comments that have deletedAt set', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // Then
+      await getCommentsByArticle(slug);
+
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: expect.objectContaining({
+                deletedAt: null,
+              }),
+            }),
+          },
+        }),
+      );
+    });
+
+    test('should return the remaining comments with the author summary', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({
+        comments: [
+          {
+            id: commentId,
+            createdAt: new Date(),
+            updatedAt: new Date(),
+            body: 'Still here',
+            author: {
+              username: 'RealWorld',
+              bio: null,
+              image: null,
+              followedBy: [],
+            },
+          },
+        ],
+      });
+
+      // Then
+      const result = await getCommentsByArticle(slug, authorId);
+
+      expect(result).toHaveLength(1);
+      expect(result?.[0]).toMatchObject({
+        id: commentId,
+        body: 'Still here',
+        author: {
+          username: 'RealWorld',
+          following: false,
+        },
+      });
+    });
+  });
+});
