+import prismaMock from '../prisma-mock';
+import {
+  deleteComment,
+  getCommentsByArticle,
+  updateComment,
+} from '../../app/routes/article/article.service';
+
+describe('ArticleService comment soft delete', () => {
+  const slug = 'How-to-train-your-dragon';
+  const commentId = 123;
+  const authorId = 456;
+
+  describe('deleteComment', () => {
+    test('should set deletedAt on the comment instead of removing it', async () => {
+      // Given
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).resolves.toBeUndefined();
+      expect(prismaMock.comment.update).toHaveBeenCalledWith({
+        where: { id: commentId },
+        data: { deletedAt: expect.any(Date) },
+      });
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should only find comments that are not deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toHaveProperty('errorCode', 404);
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ id: commentId, deletedAt: null }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw a 404 with the errors body when the comment is missing or deleted', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+        message: { errors: { comment: ['not found'] } },
+      });
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    test('should ask only for comments that are not deleted', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // When
+      await getCommentsByArticle(slug, authorId);
+
+      // Then
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: expect.objectContaining({
+                deletedAt: null,
+                OR: expect.any(Array),
+              }),
+            }),
+          },
+        }),
+      );
+    });
+  });
+
+  describe('updateComment', () => {
+    test('should not find a deleted comment and should throw a 404', async () => {
+      // Given
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(updateComment('Edited body', slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+        message: { errors: { comment: ['not found'] } },
+      });
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: expect.objectContaining({ id: commentId, deletedAt: null }),
+        }),
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+});
