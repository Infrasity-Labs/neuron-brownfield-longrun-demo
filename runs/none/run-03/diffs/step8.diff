+import prismaMock from '../prisma-mock';
+import { getArticles } from '../../app/routes/article/article.service';
+
+describe('ArticleService.getArticles', () => {
+  const mockedArticle = {
+    id: 123,
+    slug: 'How-to-train-your-dragon-456',
+    title: 'How to train your dragon',
+    description: '',
+    body: '',
+    createdAt: new Date('2026-10-01T10:00:00Z'),
+    updatedAt: new Date('2026-10-01T10:00:00Z'),
+    authorId: 456,
+    tagList: [],
+    favoritedBy: [],
+    author: {
+      username: 'RealWorld',
+      bio: null,
+      image: null,
+      followedBy: [],
+    },
+  };
+
+  describe('default page size', () => {
+    test('should take 10 articles when limit is missing', async () => {
+      // Given
+      const query = {};
+
+      // When
+      // @ts-ignore
+      prismaMock.article.count.mockResolvedValue(0);
+      // @ts-ignore
+      prismaMock.article.findMany.mockResolvedValue([]);
+
+      // Then
+      await getArticles(query);
+
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ skip: 0, take: 10 }),
+      );
+    });
+
+    test('should take 10 articles when limit is not a number', async () => {
+      // Given
+      const query = { limit: 'abc' };
+
+      // When
+      // @ts-ignore
+      prismaMock.article.count.mockResolvedValue(0);
+      // @ts-ignore
+      prismaMock.article.findMany.mockResolvedValue([]);
+
+      // Then
+      await getArticles(query);
+
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 10 }),
+      );
+    });
+
+    test('should take 10 articles when limit is zero', async () => {
+      // Given
+      const query = { limit: '0' };
+
+      // When
+      // @ts-ignore
+      prismaMock.article.count.mockResolvedValue(0);
+      // @ts-ignore
+      prismaMock.article.findMany.mockResolvedValue([]);
+
+      // Then
+      await getArticles(query);
+
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 10 }),
+      );
+    });
+  });
+
+  describe('articlesCount', () => {
+    test('should return the total match count, not the number of rows returned', async () => {
+      // Given
+      const query = { limit: '1' };
+
+      // When
+      // @ts-ignore
+      prismaMock.article.count.mockResolvedValue(42);
+      // @ts-ignore
+      prismaMock.article.findMany.mockResolvedValue([mockedArticle]);
+
+      // Then
+      const result = await getArticles(query);
+
+      expect(prismaMock.article.count).toHaveBeenCalledTimes(1);
+      expect(result.articlesCount).toBe(42);
+      expect(result.articles).toHaveLength(1);
+      expect(result.articles[0]).toMatchObject({
+        slug: 'How-to-train-your-dragon-456',
+        title: 'How to train your dragon',
+        favorited: false,
+        favoritesCount: 0,
+      });
+    });
+  });
+});
