+// 15 minutes after createdAt, from policy-edit-window
+const COMMENT_EDIT_WINDOW_MS = 15 * 60 * 1000;
+
+export const editComment = async (slug: string, id: number, body: string, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id,
+      authorId: userId,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    // No rule sets the status code for an edit refused by the window (spec open item).
+    // Until one is set, throw a plain error: the handler answers 500 and the edit is refused.
+    throw new Error('the edit window for this comment has passed');
+  }
+
+  const updated = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updated.id,
+    createdAt: updated.createdAt,
+    updatedAt: updated.updatedAt,
+    editedAt: updated.editedAt,
+    body: updated.body,
+    author: {
+      username: updated.author.username,
+      bio: updated.author.bio,
+      image: updated.author.image,
+      following: updated.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
