+const COMMENT_EDIT_WINDOW_MS = 15 * 60 * 1000;
+
+export const editComment = async (body: string, slug: string, commentId: number, id: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id: commentId,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+      authorId: true,
+    },
+  });
+
+  // OPEN: status code for a comment that is not found is not in the rule notes. Do not ship until decided.
+  if (!comment) {
+    throw new Error('comment not found');
+  }
+
+  // OPEN: status code for a non-author edit is not in the rule notes. Do not ship until decided.
+  if (comment.authorId !== id) {
+    throw new Error('you are not the author of this comment');
+  }
+
+  // OPEN: status code for an edit after the 15 minute window is not in the rule notes. Do not ship until decided.
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new Error('the edit window for this comment has closed');
+  }
+
+  const updatedComment = await prisma.comment.update({
+    where: {
+      id: commentId,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updatedComment.id,
+    createdAt: updatedComment.createdAt,
+    updatedAt: updatedComment.updatedAt,
+    editedAt: updatedComment.editedAt,
+    body: updatedComment.body,
+    author: {
+      username: updatedComment.author.username,
+      bio: updatedComment.author.bio,
+      image: updatedComment.author.image,
+      following: updatedComment.author.followedBy.some((follow: any) => follow.id === id),
+    },
+  };
+};
