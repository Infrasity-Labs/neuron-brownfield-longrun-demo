+import prismaMock from '../prisma-mock';
+import { COMMENT_EDIT_STATUS, updateComment } from '../../app/routes/article/article.service';
+
+const MINUTE = 60 * 1000;
+
+describe('ArticleService', () => {
+  describe('updateComment', () => {
+    const id = 1;
+    const slug = 'How-to-train-your-dragon';
+    const authorId = 123;
+
+    const mockedUpdatedComment = (createdAt: Date) => ({
+      id,
+      body: 'edited body',
+      createdAt,
+      updatedAt: createdAt,
+      editedAt: new Date(),
+      authorId,
+      author: {
+        username: 'RealWorld',
+        bio: null,
+        image: null,
+        followedBy: [],
+      },
+    });
+
+    test('should update the body and set editedAt for the author within the window', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 5 * MINUTE);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({ createdAt, authorId });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(createdAt));
+
+      const result = await updateComment('edited body', slug, id, authorId);
+
+      // Then
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id },
+          data: expect.objectContaining({
+            body: 'edited body',
+            editedAt: expect.any(Date),
+          }),
+        }),
+      );
+      expect(result).toMatchObject({
+        id,
+        body: 'edited body',
+        editedAt: expect.any(Date),
+        author: { username: 'RealWorld' },
+      });
+    });
+
+    test('should allow the edit just before the 30 minute window closes', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 29 * MINUTE);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({ createdAt, authorId });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(createdAt));
+
+      // Then
+      await expect(updateComment('edited body', slug, id, authorId)).resolves.toHaveProperty(
+        'editedAt',
+      );
+    });
+
+    test('should reject a blank body with 422 and not update', async () => {
+      // Then
+      await expect(updateComment('', slug, id, authorId)).rejects.toMatchObject({
+        errorCode: 422,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should reject when no comment with that id is on the article', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(updateComment('edited body', slug, id, authorId)).rejects.toMatchObject({
+        errorCode: COMMENT_EDIT_STATUS.notFound,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should reject when the requester is not the author and not update', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 5 * MINUTE);
+      const otherUserId = 999;
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({ createdAt, authorId });
+
+      // Then
+      await expect(updateComment('edited body', slug, id, otherUserId)).rejects.toMatchObject({
+        errorCode: COMMENT_EDIT_STATUS.notAuthor,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should reject once 30 minutes have passed since creation and not update', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 31 * MINUTE);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({ createdAt, authorId });
+
+      // Then
+      await expect(updateComment('edited body', slug, id, authorId)).rejects.toMatchObject({
+        errorCode: COMMENT_EDIT_STATUS.windowClosed,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+});
