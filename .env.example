# Copy to .env and fill in. .env is git-ignored. Never commit a key.
# Load it before running the scripts:  set -a; source .env; set +a

# Which model Neuron uses for ingest and ask. These feed scripts/setup_vaults.sh, which passes them to
# `okto-neuron onboard`. Pick a provider preset from the Neuron README, for example openrouter, openai, gemini, anthropic.
# For OpenRouter use DEMO_LLM_PROVIDER=openai and DEMO_LLM_API_BASE=https://openrouter.ai/api/v1 (see docs/VERIFIED.md).
DEMO_LLM_PROVIDER=
DEMO_LLM_MODEL=
# Leave empty to use the preset's own base URL. Set it for a custom endpoint. The anthropic preset needed
# https://api.anthropic.com in the pilot (docs/PRODUCT-OBSERVATIONS.md, item 1).
DEMO_LLM_API_BASE=
# The NAME of the variable that holds the key. Neuron wants it to start with OKTO_NEURON_.
DEMO_LLM_API_KEY_ENV=OKTO_NEURON_LLM_API_KEY
# The key itself, under the name given above. scripts/setup_vaults.sh does not put it on a command line: onboard
# reads the variable named by --api-key-env from the environment.
OKTO_NEURON_LLM_API_KEY=

# Postgres from docker-compose.yml, used by the target app in app/. A local demo credential, not a secret.
DATABASE_URL=postgresql://realworld:realworld@localhost:5433/realworld

# The demo runs its own isolated Neuron daemon, so it never touches yours. These are the defaults, shown for reference.
# Neuron's app home is ~/.okto-neuron, so a separate HOME separates everything: vaults, saved key, runtime, token.
# DEMO_NEURON_HOME=./.demo-home
# DEMO_NEURON_REST_PORT=17777     (okto-neuron serve --port)
# DEMO_NEURON_MCP_PORT=18201      (okto-neuron serve --mcp-port)

# Optional overrides for run_demo.py. The token path is ~/.okto-neuron/daemon-<rest port>.token under the isolated
# HOME. It is defined in Neuron's source (server/runtime.py) and in its install.sh. The public README does not
# mention it: it only says that MCP "requires the daemon bearer credential". Source list: docs/NEURON-USAGE.md.
# OKTO_NEURON_MCP_URL=http://127.0.0.1:18201/mcp
# OKTO_NEURON_TOKEN_FILE=./.demo-home/.okto-neuron/daemon-17777.token
