+import prismaMock from '../prisma-mock';
+import {
+  ARTICLE_LIST_DEFAULT_LIMIT,
+  ARTICLE_LIST_MAX_LIMIT,
+  getArticles,
+} from '../../app/routes/article/article.service';
+
+describe('ArticleService', () => {
+  describe('getArticles limit', () => {
+    beforeEach(() => {
+      // @ts-ignore
+      prismaMock.article.count.mockResolvedValue(0);
+      // @ts-ignore
+      prismaMock.article.findMany.mockResolvedValue([]);
+    });
+
+    test('should use the default limit of 10 when no limit is given', async () => {
+      // Given
+      const query = {};
+
+      // When
+      await getArticles(query);
+
+      // Then
+      expect(ARTICLE_LIST_DEFAULT_LIMIT).toBe(10);
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 10 }),
+      );
+    });
+
+    test('should pass a limit under the cap through unchanged', async () => {
+      // Given
+      const query = { limit: '20' };
+
+      // When
+      await getArticles(query);
+
+      // Then
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 20 }),
+      );
+    });
+
+    test('should cap a limit above the maximum at 50', async () => {
+      // Given
+      const query = { limit: '100' };
+
+      // When
+      await getArticles(query);
+
+      // Then
+      expect(ARTICLE_LIST_MAX_LIMIT).toBe(50);
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 50 }),
+      );
+    });
+
+    test('should accept a limit equal to the maximum without changing it', async () => {
+      // Given
+      const query = { limit: '50' };
+
+      // When
+      await getArticles(query);
+
+      // Then
+      expect(prismaMock.article.findMany).toHaveBeenCalledWith(
+        expect.objectContaining({ take: 50 }),
+      );
+    });
+  });
+});
