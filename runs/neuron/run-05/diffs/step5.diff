+import prismaMock from '../prisma-mock';
+import { EDIT_REFUSED_STATUS, updateComment } from '../../app/routes/article/article.service';
+import HttpException from '../../app/models/http-exception.model';
+
+const EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+describe('ArticleService', () => {
+  describe('updateComment', () => {
+    const slug = 'How-to-train-your-dragon-1';
+    const commentId = 123;
+    const authorId = 456;
+
+    const mockedUpdatedComment = (body: string) => ({
+      id: commentId,
+      body,
+      createdAt: new Date(Date.now() - 60 * 1000),
+      updatedAt: new Date(),
+      editedAt: new Date(),
+      articleId: 1,
+      authorId,
+      author: {
+        username: 'RealWorld',
+        bio: null,
+        image: null,
+        followedBy: [],
+      },
+    });
+
+    test('should set editedAt when the author edits within 30 minutes', async () => {
+      // Given
+      const newBody = 'An edited comment';
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(Date.now() - 60 * 1000),
+        author: { id: authorId },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment(newBody));
+
+      // Then
+      const result = await updateComment(newBody, slug, commentId, authorId);
+
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId },
+          data: expect.objectContaining({
+            body: newBody,
+            editedAt: expect.any(Date),
+          }),
+        }),
+      );
+      expect(result).toHaveProperty('editedAt');
+      expect(result.body).toBe(newBody);
+    });
+
+    test('should look the comment up under the article slug', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(),
+        author: { id: authorId },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(mockedUpdatedComment('text'));
+
+      // Then
+      await updateComment('text', slug, commentId, authorId);
+
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId, article: { slug } },
+        }),
+      );
+    });
+
+    test('should refuse the edit when the caller is not the author', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(),
+        author: { id: 999 },
+      });
+
+      // Then
+      const attempt = updateComment('text', slug, commentId, authorId);
+      await expect(attempt).rejects.toBeInstanceOf(HttpException);
+      await expect(attempt).rejects.toHaveProperty('errorCode', EDIT_REFUSED_STATUS);
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should refuse the edit when the comment is not found', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      const attempt = updateComment('text', slug, commentId, authorId);
+      await expect(attempt).rejects.toBeInstanceOf(HttpException);
+      await expect(attempt).rejects.toHaveProperty('errorCode', EDIT_REFUSED_STATUS);
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should refuse the edit when the 30 minute window has passed', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        createdAt: new Date(Date.now() - EDIT_WINDOW_MS - 60 * 1000),
+        author: { id: authorId },
+      });
+
+      // Then
+      const attempt = updateComment('text', slug, commentId, authorId);
+      await expect(attempt).rejects.toBeInstanceOf(HttpException);
+      await expect(attempt).rejects.toHaveProperty('errorCode', EDIT_REFUSED_STATUS);
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should return 422 with the errors shape when the body is blank', async () => {
+      // Then
+      const attempt = updateComment('', slug, commentId, authorId);
+      await expect(attempt).rejects.toBeInstanceOf(HttpException);
+      await expect(attempt).rejects.toHaveProperty('errorCode', 422);
+      await expect(attempt).rejects.toHaveProperty('message', {
+        errors: { body: ["can't be blank"] },
+      });
+      expect(prismaMock.comment.findFirst).not.toHaveBeenCalled();
+    });
+  });
+});
