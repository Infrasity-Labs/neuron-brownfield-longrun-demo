@@ -0,0 +1,135 @@
+import prismaMock from '../prisma-mock';
+import { editComment } from '../../app/routes/article/article.service';
+
+const MINUTE_MS = 60 * 1000;
+
+const slug = 'how-to-train-your-dragon-456';
+const commentId = 123;
+const authorId = 456;
+
+const mockedCommentLookup = (createdAt: Date, commentAuthorId: number) => ({
+  createdAt,
+  authorId: commentAuthorId,
+});
+
+const mockedUpdateResponse = (body: string, editedAt: Date) => ({
+  id: commentId,
+  createdAt: new Date(Date.now() - 5 * MINUTE_MS),
+  updatedAt: new Date(),
+  body,
+  editedAt,
+  articleId: 1,
+  authorId,
+  author: {
+    username: 'RealWorld',
+    bio: null,
+    image: null,
+    followedBy: [],
+  },
+});
+
+describe('ArticleService', () => {
+  describe('editComment', () => {
+    test('should update the body and set editedAt when the author edits within the window', async () => {
+      // Given
+      const newBody = 'Edited body';
+      const createdAt = new Date(Date.now() - 5 * MINUTE_MS);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt, authorId));
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(
+        mockedUpdateResponse(newBody, new Date()),
+      );
+
+      // Then
+      const result = await editComment(newBody, slug, commentId, authorId);
+
+      expect(prismaMock.comment.update).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: { id: commentId },
+          data: { body: newBody, editedAt: expect.any(Date) },
+        }),
+      );
+      expect(result.body).toBe(newBody);
+      expect(result.editedAt).toBeInstanceOf(Date);
+    });
+
+    test('should allow an edit at 14 minutes after creation', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 14 * MINUTE_MS);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt, authorId));
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue(
+        mockedUpdateResponse('Edited body', new Date()),
+      );
+
+      // Then
+      await expect(editComment('Edited body', slug, commentId, authorId)).resolves.toHaveProperty(
+        'editedAt',
+      );
+    });
+
+    test('should throw a 422 with the errors body shape when the body is blank', async () => {
+      // Given
+      const blankBody = '';
+
+      // Then
+      await expect(editComment(blankBody, slug, commentId, authorId)).rejects.toMatchObject({
+        errorCode: 422,
+        message: { errors: { body: ["can't be blank"] } },
+      });
+      expect(prismaMock.comment.findFirst).not.toHaveBeenCalled();
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw and not update when the comment is not found', async () => {
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(editComment('Edited body', slug, commentId, authorId)).rejects.toThrow(
+        'comment not found',
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw and not update when the user is not the author', async () => {
+      // Given
+      const otherUserId = 999;
+      const createdAt = new Date(Date.now() - 5 * MINUTE_MS);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(
+        mockedCommentLookup(createdAt, otherUserId),
+      );
+
+      // Then
+      await expect(editComment('Edited body', slug, commentId, authorId)).rejects.toThrow(
+        'you are not the author of this comment',
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+
+    test('should throw and not update when the edit window has closed', async () => {
+      // Given
+      const createdAt = new Date(Date.now() - 16 * MINUTE_MS);
+
+      // When
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(mockedCommentLookup(createdAt, authorId));
+
+      // Then
+      await expect(editComment('Edited body', slug, commentId, authorId)).rejects.toThrow(
+        'the edit window for this comment has closed',
+      );
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+});
