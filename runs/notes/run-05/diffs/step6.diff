+// Comment edit window, from policy-edit-window.md (30 minutes after createdAt).
+export const COMMENT_EDIT_WINDOW_MS = 30 * 60 * 1000;
+
+// Open point in specs/feature-1-comment-editing.md: no rule sets the status for
+// a non-author edit or an edit after the window. 403 is a placeholder until the
+// team decides. Not from any rule.
+export const COMMENT_EDIT_NOT_AUTHOR_STATUS = 403;
+export const COMMENT_EDIT_EXPIRED_STATUS = 403;
+
+export const updateComment = async (body: string, slug: string, id: number, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+      authorId: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (comment.authorId !== userId) {
+    throw new HttpException(COMMENT_EDIT_NOT_AUTHOR_STATUS, {
+      errors: { comment: ['only the author can edit this comment'] },
+    });
+  }
+
+  if (Date.now() - comment.createdAt.getTime() > COMMENT_EDIT_WINDOW_MS) {
+    throw new HttpException(COMMENT_EDIT_EXPIRED_STATUS, {
+      errors: { comment: ['can no longer be edited'] },
+    });
+  }
+
+  const now = new Date();
+
+  const updated = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      updatedAt: now,
+      editedAt: now,
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updated.id,
+    createdAt: updated.createdAt,
+    updatedAt: updated.updatedAt,
+    editedAt: updated.editedAt,
+    body: updated.body,
+    author: {
+      username: updated.author.username,
+      bio: updated.author.bio,
+      image: updated.author.image,
+      following: updated.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
