+// Edit window after a comment is created. Source: team vault, policy-edit-window.md (bytes 0-150), 30 minutes.
+const COMMENT_EDIT_WINDOW_MINUTES = 30;
+
+// Status codes for the comment-edit errors. The team vault sets no status code for these cases
+// (it only says the API "refuses the edit" after the window). These values are placeholders
+// that match deleteComment and updateArticle, not confirmed rules. The user must confirm them.
+export const COMMENT_EDIT_STATUS = {
+  notFound: 404,
+  notAuthor: 403,
+  windowClosed: 403,
+};
+
+export const updateComment = async (body: string, slug: string, id: number, userId: number) => {
+  if (!body) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      createdAt: true,
+      authorId: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(COMMENT_EDIT_STATUS.notFound, { errors: { comment: ['not found'] } });
+  }
+
+  if (comment.authorId !== userId) {
+    throw new HttpException(COMMENT_EDIT_STATUS.notAuthor, {
+      errors: { comment: ['only the author can edit this comment'] },
+    });
+  }
+
+  const windowEnd = comment.createdAt.getTime() + COMMENT_EDIT_WINDOW_MINUTES * 60 * 1000;
+
+  if (Date.now() > windowEnd) {
+    throw new HttpException(COMMENT_EDIT_STATUS.windowClosed, {
+      errors: { comment: ['can no longer be edited'] },
+    });
+  }
+
+  const updated = await prisma.comment.update({
+    where: {
+      id,
+    },
+    data: {
+      body,
+      editedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updated.id,
+    createdAt: updated.createdAt,
+    updatedAt: updated.updatedAt,
+    editedAt: updated.editedAt,
+    body: updated.body,
+    author: {
+      username: updated.author.username,
+      bio: updated.author.bio,
+      image: updated.author.image,
+      following: updated.author.followedBy.some((follow: any) => follow.id === id),
+    },
+  };
+};
