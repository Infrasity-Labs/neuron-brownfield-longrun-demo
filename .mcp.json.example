{
  "_comment": "run_demo.py writes this file for each role at run time and passes it with --strict-mcp-config. It reads the token from ~/.okto-neuron/daemon-<rest port>.token under the demo's isolated HOME (default ./.demo-home, REST port 17777). That path is defined in Neuron's source and installer, not in its README (docs/NEURON-USAGE.md). You only need to copy this by hand to try a role yourself. Never commit a real token.",
  "mcpServers": {
    "okto-neuron": {
      "type": "http",
      "url": "http://127.0.0.1:18201/mcp?vault=team",
      "headers": {
        "Authorization": "Bearer <contents of ./.demo-home/.okto-neuron/daemon-17777.token>"
      }
    }
  }
}
