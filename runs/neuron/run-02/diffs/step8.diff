+import prismaMock from '../prisma-mock';
+import { deleteComment, getCommentsByArticle } from '../../app/routes/article/article.service';
+
+// Team rule (Okto Neuron, vault "team", policy-soft-delete.md): deleting a comment sets
+// deletedAt and keeps the row, comments with deletedAt set are left out of comment lists,
+// and only the comment's author may delete it.
+describe('comment soft delete', () => {
+  const slug = 'How-to-train-your-dragon';
+  const commentId = 123;
+  const authorId = 456;
+
+  describe('deleteComment', () => {
+    test('should set deletedAt and keep the row', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // When
+      await deleteComment(commentId, authorId);
+
+      // Then
+      expect(prismaMock.comment.update).toHaveBeenCalledWith({
+        where: { id: commentId },
+        data: { deletedAt: expect.any(Date) },
+      });
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should only find comments that are not already deleted and belong to the caller', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue({
+        author: { id: authorId, username: 'RealWorld' },
+      });
+      // @ts-ignore
+      prismaMock.comment.update.mockResolvedValue({});
+
+      // When
+      await deleteComment(commentId, authorId);
+
+      // Then
+      expect(prismaMock.comment.findFirst).toHaveBeenCalledWith(
+        expect.objectContaining({
+          where: {
+            id: commentId,
+            deletedAt: null,
+            author: { id: authorId },
+          },
+        }),
+      );
+    });
+
+    test('should throw a 404 and not update when the comment is already deleted', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, authorId)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+      expect(prismaMock.comment.delete).not.toHaveBeenCalled();
+    });
+
+    test('should throw a 404 and not update when someone other than the author deletes', async () => {
+      // Given
+      // The author filter is in the query, so a non-author finds nothing.
+      // @ts-ignore
+      prismaMock.comment.findFirst.mockResolvedValue(null);
+
+      // Then
+      await expect(deleteComment(commentId, 999)).rejects.toMatchObject({
+        errorCode: 404,
+      });
+      expect(prismaMock.comment.update).not.toHaveBeenCalled();
+    });
+  });
+
+  describe('getCommentsByArticle', () => {
+    test('should leave out comments that have deletedAt set', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // When
+      await getCommentsByArticle(slug, authorId);
+
+      // Then
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: expect.objectContaining({ deletedAt: null }),
+            }),
+          },
+        }),
+      );
+    });
+
+    test('should leave out deleted comments when no user is signed in', async () => {
+      // Given
+      // @ts-ignore
+      prismaMock.article.findUnique.mockResolvedValue({ comments: [] });
+
+      // When
+      await getCommentsByArticle(slug);
+
+      // Then
+      expect(prismaMock.article.findUnique).toHaveBeenCalledWith(
+        expect.objectContaining({
+          include: {
+            comments: expect.objectContaining({
+              where: expect.objectContaining({ deletedAt: null }),
+            }),
+          },
+        }),
+      );
+    });
+  });
+});
